"use strict";

$(function () {

    // ====== SINCRONIZAÇÃO DE CSRF ENTRE ABAS ======
    // Esta função sincroniza o token CSRF entre múltiplas abas do navegador
    // para evitar erros quando uma aba regenera o token e invalida as outras
    
    (function() {
        const CSRF_STORAGE_KEY = 'csrf_token_sipom';
        let CSRF_TOKEN_NAME = 'csrf_token_name'; // Padrão do CodeIgniter
        
        // Função para detectar o nome do token CSRF
        function detectarNomeToken() {
            // Tenta obter do meta tag (usado no layout organograma)
            const metaCSRF = document.querySelector('meta[name="csrf-name"]');
            if (metaCSRF && metaCSRF.content) {
                return metaCSRF.content;
            }
            
            // Tenta obter do campo hidden no formulário
            const csrfInput = document.querySelector('input[name*="csrf"]');
            if (csrfInput && csrfInput.name) {
                return csrfInput.name;
            }
            
            // Retorna o padrão
            return 'csrf_token_name';
        }
        
        // Função para atualizar token CSRF em todos os formulários da página
        function atualizarCSRF(token) {
            if (!token) return;
            
            CSRF_TOKEN_NAME = detectarNomeToken();
            
            // Atualiza todos os campos CSRF na página
            const inputs = document.querySelectorAll(`input[name="${CSRF_TOKEN_NAME}"]`);
            inputs.forEach(input => {
                input.value = token;
            });
            
            // Atualiza meta tag se existir
            const metaHash = document.querySelector('meta[name="csrf-hash"]');
            if (metaHash) {
                metaHash.content = token;
            }
            
            // Salva no localStorage para sincronizar com outras abas
            try {
                localStorage.setItem(CSRF_STORAGE_KEY, token);
            } catch(e) {
                console.warn('Erro ao salvar CSRF no localStorage:', e);
            }
        }
        
        // Função para obter token atual do formulário, meta tag ou localStorage
        function obterTokenAtual() {
            CSRF_TOKEN_NAME = detectarNomeToken();
            
            // Primeiro tenta obter do formulário atual
            const csrfInput = document.querySelector(`input[name="${CSRF_TOKEN_NAME}"]`);
            if (csrfInput && csrfInput.value) {
                return csrfInput.value;
            }
            
            // Tenta da meta tag (usado em páginas sem formulário, ex: mapa_geral)
            const metaHash = document.querySelector('meta[name="csrf-hash"]');
            if (metaHash && metaHash.content) {
                return metaHash.content;
            }
            
            // Se não encontrou, tenta do localStorage
            try {
                return localStorage.getItem(CSRF_STORAGE_KEY);
            } catch(e) {
                return null;
            }
        }
        
        // Inicializa ao carregar a página
        function inicializar() {
            CSRF_TOKEN_NAME = detectarNomeToken();
            
            // Primeiro, tenta obter o token do formulário atual (mais confiável após reload)
            const csrfInput = document.querySelector(`input[name="${CSRF_TOKEN_NAME}"]`);
            if (csrfInput && csrfInput.value) {
                // Se encontrou token no formulário, usa ele e salva no localStorage
                atualizarCSRF(csrfInput.value);
            } else {
                // Se não encontrou no formulário, busca do localStorage
                const tokenSalvo = obterTokenAtual();
                if (tokenSalvo) {
                    atualizarCSRF(tokenSalvo);
                }
            }
        }
        
        // Listener para sincronizar token quando outra aba atualiza
        window.addEventListener('storage', function(e) {
            if (e.key === CSRF_STORAGE_KEY && e.newValue) {
                atualizarCSRF(e.newValue);
            }
        });
        
        function obterRedirectLogin(payload) {
            if (payload && typeof payload.redirect === 'string' && payload.redirect.trim()) {
                return payload.redirect;
            }

            try {
                return new URL('login', window.location.origin + '/').href;
            } catch (e) {
                return '/login';
            }
        }

        function extrairMensagemResposta(payload, xhr) {
            if (payload && typeof payload === 'object') {
                return String(payload.erro || payload.message || payload.error || payload.title || '');
            }

            if (typeof payload === 'string') {
                return payload;
            }

            if (xhr && xhr.responseJSON) {
                return String(xhr.responseJSON.erro || xhr.responseJSON.message || xhr.responseJSON.error || xhr.responseJSON.title || '');
            }

            if (xhr && xhr.responseText) {
                return String(xhr.responseText);
            }

            return '';
        }

        function respostaIndicaSessaoExpirada(status, payload, xhr) {
            const dados = payload || (xhr && xhr.responseJSON) || null;
            const mensagem = extrairMensagemResposta(dados, xhr).toLowerCase();

            if (status === 401) {
                return true;
            }

            if (status !== 403) {
                return false;
            }

            const tipoErro = String((dados && dados.type) || (dados && dados.title) || '').toLowerCase();
            if (tipoErro.indexOf('securityexception') >= 0) {
                return true;
            }

            return mensagem.indexOf('sessão expirada') >= 0
                || mensagem.indexOf('sessao expirada') >= 0
                || mensagem.indexOf('faça login') >= 0
                || mensagem.indexOf('faca login') >= 0
                || mensagem.indexOf('login novamente') >= 0
                || mensagem.indexOf('csrf') >= 0
                || mensagem.indexOf('token') >= 0
                || mensagem.indexOf('não é permitida') >= 0
                || mensagem.indexOf('nao e permitida') >= 0
                || mensagem.indexOf('ação que você requisitou') >= 0
                || mensagem.indexOf('acao que voce requisitou') >= 0;
        }

        window.tratarSessaoExpirada = function(payload, status, xhr) {
            const statusCode = Number(status || (xhr && xhr.status) || 0);
            const dados = payload || (xhr && xhr.responseJSON) || null;

            if (!respostaIndicaSessaoExpirada(statusCode, dados, xhr)) {
                return false;
            }

            if (window.__redirecionandoLogin) {
                return true;
            }

            window.__redirecionandoLogin = true;
            const redirect = obterRedirectLogin(dados);

            if (typeof iziToast !== 'undefined') {
                iziToast.error({
                    message: 'Sessão expirada. Faça login novamente.',
                    position: 'topRight'
                });
            }

            setTimeout(function() {
                window.location.href = redirect;
            }, 600);

            return true;
        };

        function atualizarCSRFDeHeaders(getHeader) {
            if (typeof getHeader !== 'function') return;

            const csrfToken = getHeader('X-CSRF-TOKEN') || getHeader('csrf_token_name');
            const tokenNameHeader = getHeader('X-CSRF-TOKEN-NAME');

            if (csrfToken) {
                atualizarCSRF(csrfToken);
            }
            if (tokenNameHeader) {
                CSRF_TOKEN_NAME = tokenNameHeader;
            }
        }

        window.atualizarCSRFDeResposta = function(response) {
            if (!response || !response.headers || typeof response.headers.get !== 'function') return;

            atualizarCSRFDeHeaders(function(headerName) {
                return response.headers.get(headerName);
            });
        };

        window.tratarRespostaFetch = async function(response) {
            window.atualizarCSRFDeResposta(response);

            if (response.ok) {
                return response.json();
            }

            let payload = null;
            try {
                payload = await response.clone().json();
            } catch (e) {
                try {
                    payload = await response.text();
                } catch (ignore) {
                    payload = null;
                }
            }

            if (window.tratarSessaoExpirada(payload, response.status)) {
                throw { sessionRedirect: true };
            }

            throw new Error('Erro na requisição');
        };

        // Intercepta todas as requisições AJAX para atualizar o token (qualquer método: GET, POST, etc.)
        $(document).ajaxComplete(function(event, xhr) {
            atualizarCSRFDeHeaders(function(headerName) {
                return xhr.getResponseHeader(headerName);
            });
        });

        $(document).ajaxError(function(event, xhr) {
            window.tratarSessaoExpirada(null, xhr && xhr.status, xhr);
        });

        $(document).ajaxSend(function(event, xhr, settings) {
            const method = String((settings && settings.type) || (settings && settings.method) || 'GET').toUpperCase();
            if (['POST', 'PUT', 'DELETE', 'PATCH'].indexOf(method) === -1) return;

            const token = obterTokenAtual();
            if (token && xhr && typeof xhr.setRequestHeader === 'function') {
                xhr.setRequestHeader('X-CSRF-TOKEN', token);
            }
        });
        
        // Intercepta envio de formulários para atualizar token antes de enviar
        $(document).on('submit', 'form', function(e) {
            // Sempre atualiza o token antes de enviar (tanto AJAX quanto não-AJAX)
            const tokenAtualizado = obterTokenAtual();
            if (tokenAtualizado) {
                CSRF_TOKEN_NAME = detectarNomeToken();
                const csrfField = $(this).find(`input[name="${CSRF_TOKEN_NAME}"]`);
                if (csrfField.length) {
                    csrfField.val(tokenAtualizado);
                } else {
                    // Se não encontrou o campo, adiciona um hidden
                    $(this).append(`<input type="hidden" name="${CSRF_TOKEN_NAME}" value="${tokenAtualizado}">`);
                }
            }
        });
        
        // Monitora mudanças no DOM para capturar token quando formulários são adicionados dinamicamente
        const observer = new MutationObserver(function(mutations) {
            CSRF_TOKEN_NAME = detectarNomeToken();
            const csrfInput = document.querySelector(`input[name="${CSRF_TOKEN_NAME}"]`);
            if (csrfInput && csrfInput.value) {
                // Se encontrou um token novo no formulário, atualiza
                const tokenAtual = localStorage.getItem(CSRF_STORAGE_KEY);
                if (!tokenAtual || tokenAtual !== csrfInput.value) {
                    atualizarCSRF(csrfInput.value);
                }
            }
        });
        
        // Observa mudanças no body para capturar novos formulários
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        // Função global para atualizar CSRF manualmente
        window.atualizarCSRF = atualizarCSRF;
        window.obterTokenCSRF = obterTokenAtual;

        window.adicionarCSRFFormData = function(formData, tokenName) {
            if (!formData || typeof formData.append !== 'function') return;

            const nomeToken = tokenName || detectarNomeToken();
            const token = obterTokenAtual();

            if (nomeToken && token) {
                if (typeof formData.set === 'function') {
                    formData.set(nomeToken, token);
                } else {
                    formData.append(nomeToken, token);
                }
            }
        };

        window.adicionarCSRFObjeto = function(data, tokenName) {
            if (!data || typeof data !== 'object') return data;

            const nomeToken = tokenName || detectarNomeToken();
            const token = obterTokenAtual();

            if (nomeToken && token) {
                data[nomeToken] = token;
            }

            return data;
        };
        
        /**
         * Atualiza o token CSRF antes de enviar (sincronizado entre abas).
         * - Sem argumento ou argumento não sendo formulário: atualiza TODOS os campos CSRF da página (inputs e meta).
         * - Com elemento de formulário: atualiza apenas o CSRF desse formulário.
         * Uso em beforeSend de $.ajax(): window.atualizarTokenAntesEnvio();
         */
        window.atualizarTokenAntesEnvio = function(formElement) {
            const token = obterTokenAtual();
            if (!token) return;
            
            CSRF_TOKEN_NAME = detectarNomeToken();
            const $target = formElement && (formElement.nodeName === 'FORM' || (formElement && $(formElement).is('form'))) ? $(formElement) : null;
            
            if ($target && $target.length) {
                const csrfField = $target.find(`input[name="${CSRF_TOKEN_NAME}"]`);
                if (csrfField.length) {
                    csrfField.val(token);
                } else {
                    $target.append(`<input type="hidden" name="${CSRF_TOKEN_NAME}" value="${token}">`);
                }
            } else {
                // Atualiza todos os campos CSRF da página (útil para múltiplas abas e AJAX)
                const inputs = document.querySelectorAll(`input[name="${CSRF_TOKEN_NAME}"]`);
                inputs.forEach(function(input) {
                    input.value = token;
                });
                const metaHash = document.querySelector('meta[name="csrf-hash"]');
                if (metaHash) {
                    metaHash.content = token;
                }
            }
        };
        
        // Inicializa quando o DOM estiver pronto
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', inicializar);
        } else {
            inicializar();
        }
        
        // Também inicializa quando jQuery estiver pronto (caso o DOM já esteja carregado)
        $(document).ready(function() {
            inicializar();
        });
    })();

    window.atualizarBadgesNotificacoes = function(total) {
        var n = parseInt(total, 10) || 0;
        var badge = document.getElementById('notificacoes-badge');
        var headerBadge = document.getElementById('notificacoes-header-badge');
        var menuBadge = document.getElementById('notificacoes-badge-menu');

        if (badge) {
            badge.textContent = n;
            badge.style.display = n > 0 ? '' : 'none';
        }
        if (headerBadge) {
            headerBadge.textContent = n + ' nova(s)';
            headerBadge.style.display = n > 0 ? '' : 'none';
        }
        if (menuBadge) {
            menuBadge.textContent = n;
            menuBadge.style.display = n > 0 ? '' : 'none';
        }
    };

    function notificacoesDropdownVazio() {
        var lista = document.getElementById('notificacoes-dropdown-list');
        if (!lista) return;

        if (lista.querySelectorAll('.notif-dropdown-item').length === 0) {
            if (!document.getElementById('notificacoes-dropdown-vazio')) {
                var vazio = document.createElement('div');
                vazio.id = 'notificacoes-dropdown-vazio';
                vazio.className = 'dropdown-item text-muted';
                vazio.innerHTML = '<span class="dropdown-item-desc">Nenhuma notificação não lida.</span>';
                lista.appendChild(vazio);
            }
        }
    }

    function notificacoesTruncarTexto(texto, max) {
        var str = String(texto || '');
        if (str.length <= max) {
            return str;
        }
        return str.substring(0, max) + '...';
    }

    function notificacoesEscaparHtml(texto) {
        return String(texto || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function notificacoesAssinaturaHeader(data) {
        var chaves = (data.notificacoes || []).map(function(n) {
            return n.chave || '';
        }).join(',');
        return String(data.total || 0) + '|' + chaves;
    }

    function notificacoesToastStorageKey() {
        var lista = document.getElementById('notificacoes-dropdown-list');
        var usuarioChave = lista ? String(lista.dataset.usuarioChave || 'anonimo') : 'anonimo';

        return 'sipom_notificacoes_toast_vistas_v1_' + usuarioChave;
    }

    function notificacoesToastIdsVistos() {
        try {
            var salvo = sessionStorage.getItem(notificacoesToastStorageKey());
            if (salvo === null) {
                return null;
            }

            var ids = JSON.parse(salvo);
            return Array.isArray(ids) ? ids : [];
        } catch (e) {
            return [];
        }
    }

    function notificacoesSalvarToastIdsVistos(ids) {
        try {
            sessionStorage.setItem(
                notificacoesToastStorageKey(),
                JSON.stringify(ids.slice(0, 100))
            );
        } catch (e) {
            // O sino continua funcional mesmo sem sessionStorage.
        }
    }

    function notificacoesExibirToastsNovas(notificacoes) {
        if (!Array.isArray(notificacoes)) {
            return;
        }

        var idsAtuais = notificacoes
            .map(function(notif) { return String(notif.chave || ''); })
            .filter(function(id) { return id !== ''; });
        var idsVistos = notificacoesToastIdsVistos();

        // Primeira consulta da aba: cria a linha de base sem repetir notificações antigas.
        if (idsVistos === null) {
            notificacoesSalvarToastIdsVistos(idsAtuais);
            return;
        }

        var novas = notificacoes.filter(function(notif) {
            var id = String(notif.chave || '');
            return id !== '' && idsVistos.indexOf(id) === -1;
        });

        notificacoesSalvarToastIdsVistos(
            idsAtuais.concat(idsVistos.filter(function(id) {
                return idsAtuais.indexOf(id) === -1;
            }))
        );

        if (novas.length === 0 || typeof iziToast === 'undefined') {
            return;
        }

        novas.slice(0, 3).reverse().forEach(function(notif) {
            iziToast.info({
                title: notif.origem_modulo === 'documentos' ? 'Documentos' : 'Notificação',
                message: notificacoesEscaparHtml(notif.mensagem || ''),
                position: 'topRight',
                timeout: 8000,
                close: true,
                pauseOnHover: true,
                onOpening: function(instance, toast) {
                    if (!notif.link) {
                        return;
                    }

                    toast.style.cursor = 'pointer';
                    toast.setAttribute('title', 'Clique para abrir');
                    toast.addEventListener('click', function(event) {
                        if (event.target && event.target.closest('.iziToast-close')) {
                            return;
                        }
                        window.location.href = notif.link;
                    });
                }
            });
        });
    }

    function notificacoesIconeModulo(origemModulo) {
        return origemModulo === 'documentos' ? 'fa-file-alt' : 'fa-bell';
    }

    function notificacoesCorIconeModulo(origemModulo) {
        return origemModulo === 'documentos' ? 'bg-primary' : 'bg-info';
    }

    function renderizarNotificacoesHeader(notificacoes, podeMarcar) {
        var lista = document.getElementById('notificacoes-dropdown-list');
        if (!lista) {
            return;
        }

        if (typeof podeMarcar === 'undefined') {
            podeMarcar = lista.dataset.podeMarcar === '1';
        }

        lista.innerHTML = '';

        if (!notificacoes || notificacoes.length === 0) {
            notificacoesDropdownVazio();
            return;
        }

        notificacoes.forEach(function(notif) {
            var item = document.createElement('div');
            item.className = 'dropdown-item dropdown-item-unread notif-dropdown-item';
            item.dataset.id = notif.id;

            var mensagem = notificacoesEscaparHtml(notificacoesTruncarTexto(notif.mensagem, 80));
            var mensagemHtml = notif.link
                ? '<a href="' + notificacoesEscaparHtml(notif.link) + '" class="text-dark">' + mensagem + '</a>'
                : mensagem;
            var dataHtml = notif.data
                ? '<span class="time">' + notificacoesEscaparHtml(notif.data) + '</span>'
                : '';
            var prefixoHtml = '';

            if (podeMarcar) {
                prefixoHtml =
                    '<label class="notif-check-label" title="Marcar como lida">' +
                        '<input type="checkbox" class="notif-dropdown-check" data-id="' + notificacoesEscaparHtml(notif.id) + '">' +
                        '<span class="notif-check-box" aria-hidden="true"></span>' +
                    '</label>';
            } else {
                var icone = notificacoesIconeModulo(notif.origem_modulo || '');
                var cor = notificacoesCorIconeModulo(notif.origem_modulo || '');
                prefixoHtml =
                    '<span class="dropdown-item-icon ' + cor + ' text-white">' +
                        '<i class="fas ' + icone + '"></i>' +
                    '</span>';
            }

            item.innerHTML =
                prefixoHtml +
                '<span class="dropdown-item-desc">' + mensagemHtml + dataHtml + '</span>';

            lista.appendChild(item);
        });
    }

    function buscarNotificacoesHeader(forcarAtualizacao) {
        var lista = document.getElementById('notificacoes-dropdown-list');
        if (!lista || !lista.dataset.headerUrl) {
            return;
        }

        fetch(lista.dataset.headerUrl, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(window.tratarRespostaFetch)
        .then(function(data) {
            var assinatura = notificacoesAssinaturaHeader(data);
            if (!forcarAtualizacao && assinatura === window._notifHeaderAssinatura) {
                return;
            }
            window._notifHeaderAssinatura = assinatura;

            if (typeof data.total !== 'undefined') {
                window.atualizarBadgesNotificacoes(data.total);
            }
            if (Array.isArray(data.notificacoes)) {
                notificacoesExibirToastsNovas(data.notificacoes);
                renderizarNotificacoesHeader(data.notificacoes, !!data.pode_marcar);
            }
        })
        .catch(function() {});
    }

    (function iniciarPollingNotificacoesHeader() {
        var lista = document.getElementById('notificacoes-dropdown-list');
        if (!lista || !lista.dataset.headerUrl) {
            return;
        }

        buscarNotificacoesHeader();
        setInterval(buscarNotificacoesHeader, 10000);
    })();

    // Dropdown de notificações: só fecha ao clicar fora (Bootstrap 4)
    $(document).on('shown.bs.dropdown', '.dropdown-list-toggle', function () {
        buscarNotificacoesHeader(true);

        $(this).children('.dropdown-menu.dropdown-list')
            .off('click.notifDropdown')
            .on('click.notifDropdown', function (e) {
                e.stopPropagation();
            });
    });

    $(document).on('hidden.bs.dropdown', '.dropdown-list-toggle', function () {
        $(this).children('.dropdown-menu.dropdown-list').off('click.notifDropdown');
    });

    $(document).on('click', '.notif-check-label, .notif-dropdown-check', function(e) {
        e.stopPropagation();
    });

    $(document).on('change', '.notif-dropdown-check', function(e) {
        e.stopPropagation();
        var checkbox = this;
        if (!checkbox.checked) return;

        var encId = checkbox.dataset.id;
        var item = checkbox.closest('.notif-dropdown-item');
        var lista = document.getElementById('notificacoes-dropdown-list');
        var baseUrl = lista ? lista.dataset.marcarUrl : '';

        if (!encId || !baseUrl) {
            checkbox.checked = false;
            return;
        }

        checkbox.disabled = true;
        var checkBoxUi = checkbox.parentElement ? checkbox.parentElement.querySelector('.notif-check-box') : null;

        fetch(baseUrl + '/' + encId, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-TOKEN': window.obterTokenCSRF ? window.obterTokenCSRF() : ''
            }
        })
        .then(window.tratarRespostaFetch)
        .then(function(data) {
            if (checkBoxUi) {
                checkBoxUi.style.opacity = '0.55';
            }
            if (item) {
                $(item).fadeOut(200, function() {
                    item.remove();
                    notificacoesDropdownVazio();
                });
            }
            if (typeof data.total !== 'undefined') {
                window.atualizarBadgesNotificacoes(data.total);
            }
            window._notifHeaderAssinatura = null;
        })
        .catch(function() {
            checkbox.checked = false;
            checkbox.disabled = false;
        });
    });
});